{
    "name": "@eliware/errors",
    "type": "module",
    "version": "1.1.9",
    "description": "Process-level handlers for uncaught exceptions, unhandled rejections, and warnings.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md",
        "examples"
    ],
    "publishConfig": { "access": "public" },
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/errors.git"
    },
    "keywords": [
        "nodejs",
        "error handling",
        "process",
        "uncaughtException",
        "unhandledRejection",
        "warning",
        "process exit",
        "exception handler",
        "logger",
        "logging",
        "node error handler",
        "node process events",
        "graceful shutdown",
        "testable error handler",
        "@eliware/errors",
        "@eliware/log"
    ],
    "author": "Eli Sterling, eliware.org <russell@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/errors/issues"
    },
    "homepage": "https://github.com/eliware/errors#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@eliware/log": "^1.1.12"
    },
    "engines": {
        "node": ">=26"
    },
    "sideEffects": false
}
